# This `.xcode.env` file is versioned and is used to source the environment
# used when running script phases inside Xcode.
# To customize your local environment, you can create an `.xcode.env.local`
# file that is not versioned.

# NODE_BINARY variable contains the PATH to the node executable.
# Xcode runs script phases with a minimal PATH, so we add common locations
# so that `node` can be found when building from Xcode (not just from Terminal).
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

# Load nvm if present (common on macOS) so node from nvm is available
if [ -s "$HOME/.nvm/nvm.sh" ]; then
  export NVM_DIR="$HOME/.nvm"
  . "$HOME/.nvm/nvm.sh" --no-use 2>/dev/null || true
  (nvm use default 2>/dev/null || nvm use node 2>/dev/null) || true
fi

# Load fnm if present
if [ -x "$HOME/.fnm/fnm" ]; then
  eval "$("$HOME/.fnm/fnm" env 2>/dev/null)" || true
fi

# Volta
if [ -x "$HOME/.volta/bin/node" ]; then
  export PATH="$HOME/.volta/bin:$PATH"
fi

# Now set NODE_BINARY so Hermes and ReactNativeDependencies script phases can find node
export NODE_BINARY=$(command -v node)
