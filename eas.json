{
  "cli": {
    "version": ">= 16.32.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": false,
      "ios": {
        "buildConfiguration": "Release",
        "env": {
          "NODE_OPTIONS": "--max-old-space-size=4096"
        }
      },
      "prebuild": "./eas-build-post-install.sh"
    }
  },
  "submit": {
    "production": {}
  }
}
